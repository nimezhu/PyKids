#!/usr/bin/env bash
# PyKids launcher: pick a Python file, then edit it (left) and watch it run (right).
#
#   ./learn              start menu: continue, next lesson, open a file, or new
#   ./learn open         pick a file from the list
#   ./learn FILE         open FILE straight away
#   ./learn new [NAME]   make a new file in my_code/ (NAME can have folders: games/snake)
#   ./learn --vim ...    use vim instead of micro (remembered until you quit)
#   ./learn stop         close everything
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KIT="$ROOT/.kit"
T=(tmux -L pykids -f "$KIT/tmux.conf")
SESSION=pykids

die() { echo "🐍 $*" >&2; exit 1; }

# ------------------------------------------------------------------ helpers

editor_cmd() {  # editor_cmd FILE -> shell command that edits FILE then closes the window
    local f; f=$(printf %q "$1")
    case "${PYKIDS_EDITOR:-micro}" in
        vim) echo "vim -c 'set expandtab tabstop=4 shiftwidth=4 autoindent number mouse=a' $f; tmux kill-window" ;;
        *)   echo "micro -config-dir $(printf %q "$KIT/micro") $f; tmux kill-window" ;;
    esac
}

key_hints() {
    case "${PYKIDS_EDITOR:-micro}" in
        vim) echo "F1 help │ F2 open file │ i type, Esc stop │ :w save & run │ :q close " ;;
        *)   echo "F1 help │ F2 open file │ Ctrl-S save & run │ Ctrl-Q close " ;;
    esac
}

new_file() {  # new_file [NAME] [FOLDER] -> prints path of the new file
    local name="${1:-}" dir="${2:-my_code}"   # NAME may have folders: games/snake
    while [[ -z "$name" ]]; do
        read -rp "✨ Name for your new file in $dir/ (like: my_game): " name </dev/tty
    done
    name="${name%.py}"
    name=$(echo "$name" | tr 'A-Z -' 'a-z__' | tr -cd 'a-z0-9_/' | tr -s '/')
    name="${name#/}"; name="${name%/}"
    [[ -n "$name" ]] || die "Use letters and numbers for the name."
    local path="$dir/$name.py"
    mkdir -p "$(dirname "$ROOT/$path")"
    if [[ ! -e "$ROOT/$path" ]]; then
        printf '# %s\n# Made by me on %s\n\nprint("Hello from %s!")\n' \
            "${name##*/}" "$(date +%Y-%m-%d)" "${name##*/}" > "$ROOT/$path"
    fi
    echo "$path"
}

tree_lines() {  # tree_lines DIR PAD : "path<TAB>label" lines, a folder's files before its folders
    local dir="$1" pad="$2" f
    [[ -d "$ROOT/$dir" ]] || return 0
    printf '%s/\t%s📁 %s/\n' "$dir" "$pad" "${dir##*/}"
    for f in "$ROOT/$dir"/*.py; do
        [[ -f "$f" ]] && printf '%s/%s\t%s   %s\n' "$dir" "${f##*/}" "$pad" "${f##*/}"
    done
    for f in "$ROOT/$dir"/*/; do
        f="${f%/}"; f="${f##*/}"
        [[ -d "$ROOT/$dir/$f" && "$f" != __pycache__ ]] && tree_lines "$dir/$f" "$pad   "
    done
    return 0
}

pick_file() {  # prints the chosen path (relative to ROOT), or nothing
    cd "$ROOT"
    local new="✨ Make a NEW file" lines choice
    lines=$(tree_lines lessons ""; tree_lines my_code "")
    if command -v fzf >/dev/null; then
        # Each line is "path<TAB>label": fzf shows the label, we get the path back.
        local preview='f={1}; if [ "$f" = NEW ]; then echo "Make a brand new file in my_code/"
            elif [ -d "$f" ]; then echo "📁 $f"; echo; echo "Enter makes a new file in this folder."
            else echo "📄 $f"; echo; batcat --color=always --style=numbers "$f" 2>/dev/null || bat --color=always --style=numbers "$f" 2>/dev/null || cat -n "$f"; fi'
        choice=$(printf 'NEW\t%s\n%s\n' "$new" "$lines" | fzf \
            --delimiter=$'\t' --with-nth=2 --no-sort \
            --prompt="🐍 Open > " --header="Enter opens · Enter on 📁 = new file" \
            --reverse --height=100% --preview="$preview" --preview-window='right,60%,<40(down,40%)' ) || true
        choice=${choice%%$'\t'*}
    else
        # Our own numbered menu: NEW is 0 and lesson 05 is number 5. Folders are headings.
        local list=() path label n=0  # no mapfile: macOS ships bash 3.2
        printf '%4s  %s\n' "0)" "$new" >&2
        while IFS=$'\t' read -r path label; do
            if [[ "$path" == */ ]]; then
                printf '%4s  %s\n' "" "$label" >&2
            else
                list+=("$path"); n=$((n + 1))
                printf '%4s  %s\n' "$n)" "$label" >&2
            fi
        done <<<"$lines"
        while read -rp "Type a number and press Enter (just Enter to cancel): " n </dev/tty; do
            [[ -z "$n" ]] && break
            if [[ "$n" =~ ^[0-9]+$ ]]; then
                n=$((10#$n))  # "05" -> 5, not an octal error
                if (( n == 0 )); then choice=NEW; break; fi
                if (( n <= ${#list[@]} )); then choice=${list[n-1]}; break; fi
            fi
            echo "Pick a number from 0 to ${#list[@]}." >&2
        done
    fi
    case "${choice:-}" in
        "")  ;;
        NEW) new_file ;;
        */)  new_file "" "${choice%/}" ;;
        *)   echo "$choice" ;;
    esac
}

# ------------------------------------------------------------------ start menu

remember() {  # remember FILE : for "Continue" and "Next lesson" in the start menu
    echo "$1" > "$KIT/.last_file" 2>/dev/null || true
    [[ "$1" == lessons/* ]] && { echo "$1" > "$KIT/.last_lesson" 2>/dev/null || true; }
    return 0
}

next_lesson() {  # the lesson after the last one opened, the first if none, nothing after the last
    local last="" f found=""
    [[ -f "$KIT/.last_lesson" ]] && last=$(cat "$KIT/.last_lesson")
    for f in "$ROOT"/lessons/*.py; do
        f="lessons/${f##*/}"
        if [[ -z "$last" || -n "$found" ]]; then echo "$f"; return 0; fi
        [[ "$f" == "$last" ]] && found=1
    done
    [[ -n "$found" ]] || echo "lessons/01_hello.py"   # the last lesson was renamed: start over
    return 0
}

welcome() {  # the start menu; prints the chosen file (or nothing)
    cd "$ROOT"
    local last="" next default key
    [[ -f "$KIT/.last_file" ]] && last=$(cat "$KIT/.last_file")
    [[ -n "$last" && -f "$ROOT/$last" ]] || last=""
    next=$(next_lesson)
    default=o; [[ -n "$next" ]] && default=l; [[ -n "$last" ]] && default=c

    local B=$'\033[1m' D=$'\033[2m' C=$'\033[36m' R=$'\033[0m'
    {
        printf '\033[2J\033[H\n  %s🐍 PyKids%s  %slet'\''s code!%s\n\n' "$B" "$R" "$D" "$R"
        [[ -n "$last" ]] && printf '    %sc%s   ▶  Continue       %s%s%s\n' "$C$B" "$R" "$D" "$last" "$R"
        [[ -n "$next" ]] && printf '    %sl%s   📘 Next lesson    %s%s%s\n' "$C$B" "$R" "$D" "$next" "$R"
        [[ -z "$next" ]] && printf '        🎉 %sYou opened every lesson!%s\n' "$D" "$R"
        printf '    %so%s   📂 Open a file…\n' "$C$B" "$R"
        printf '    %sn%s   ✨ New program\n' "$C$B" "$R"
        printf '    %sq%s   👋 Quit\n\n' "$C$B" "$R"
        printf '  Press a letter %s(Enter = %s)%s ' "$D" "$default" "$R"
    } >&2
    while IFS= read -rsn1 key </dev/tty; do
        [[ -z "$key" ]] && key=$default
        case "$key" in
            c) [[ -n "$last" ]] || continue; echo >&2; echo "$last"; return 0 ;;
            l) [[ -n "$next" ]] || continue; echo >&2; echo "$next"; return 0 ;;
            o) printf '\033[2J\033[H' >&2; pick_file; return 0 ;;
            n) printf '\033[2J\033[H' >&2; new_file; return 0 ;;
            q|$'\e') echo >&2; return 0 ;;
        esac
    done
    return 0
}

open_window() {  # open_window FILE : a tmux window with editor | runner
    local file="$1" name; name=$(basename "$file" .py)
    remember "$file"

    # Already open? Just switch to it.
    local existing
    existing=$("${T[@]}" list-windows -t "$SESSION" -F '#{window_id} #{@file}' 2>/dev/null \
               | awk -v f="$file" '$2 == f {print $1; exit}' || true)
    if [[ -n "$existing" ]]; then
        "${T[@]}" select-window -t "$existing"
        return
    fi

    local editor_pane
    if "${T[@]}" has-session -t "$SESSION" 2>/dev/null; then
        editor_pane=$("${T[@]}" new-window -P -F '#{pane_id}' -t "$SESSION" -n "$name" \
                      -c "$ROOT" "$(editor_cmd "$file")")
    else
        editor_pane=$("${T[@]}" new-session -d -P -F '#{pane_id}' -s "$SESSION" -n "$name" \
                      -x "$(tput cols 2>/dev/null || echo 80)" -y "$(tput lines 2>/dev/null || echo 24)" \
                      -c "$ROOT" "$(editor_cmd "$file")")
        setup_session
    fi
    "${T[@]}" set-option -w -t "$editor_pane" @file "$file"
    "${T[@]}" set-option -p -t "$editor_pane" @label "CODE: $file"

    local run_pane
    run_pane=$("${T[@]}" split-window -h -P -F '#{pane_id}' -t "$editor_pane" -c "$ROOT" \
               "python3 $(printf %q "$KIT/run.py") $(printf %q "$file")")
    "${T[@]}" set-option -p -t "$run_pane" @label "OUTPUT  (click here to type answers)"
    "${T[@]}" select-pane -t "$editor_pane"
    relayout
}

NARROW=80   # below this many columns, code goes on top and output below

relayout() {  # size every window: side by side when wide, stacked when narrow
    local win w h
    "${T[@]}" list-windows -t "$SESSION" -F '#{window_id} #{window_width} #{window_height}' 2>/dev/null |
    while read -r win w h; do
        if (( w < NARROW )); then
            "${T[@]}" set-option -w -t "$win" main-pane-height $(( h * 60 / 100 ))
            "${T[@]}" select-layout -t "$win" main-horizontal
        else
            "${T[@]}" set-option -w -t "$win" main-pane-width $(( w * 55 / 100 ))
            "${T[@]}" select-layout -t "$win" main-vertical
        fi
    done
}

setup_session() {
    "${T[@]}" set-environment -g PYKIDS_EDITOR "${PYKIDS_EDITOR:-micro}"
    "${T[@]}" set-option -g status-right "$(key_hints)"
    local picker="$(printf %q "$ROOT/learn") --in-tmux"
    local probe; probe=$("${T[@]}" display-popup -h 2>&1 || true)
    local help="less -R $(printf %q "$KIT/cheatsheet.txt")"
    if [[ "$probe" == *"unknown command"* ]]; then              # old tmux: no popups
        "${T[@]}" bind -n F2 new-window -n open "$picker"
        "${T[@]}" bind -n F1 new-window -n help "$help"
    else
        "${T[@]}" bind -n F2 display-popup -E -w 85% -h 80% "$picker"
        "${T[@]}" bind -n F1 display-popup -E -w 75% -h 90% "$help"
    fi
    # Turning a phone (or resizing the terminal) switches between the two layouts.
    "${T[@]}" set-hook -g client-resized \
        "run-shell '$(printf %q "$ROOT/learn") --relayout >/dev/null 2>&1'" 2>/dev/null || true
}

# ------------------------------------------------------------------ main

command -v tmux >/dev/null || die "Please install tmux first:  sudo apt install tmux fzf micro"
[[ "${1:-}" == --relayout ]] && { relayout; exit 0; }   # from the client-resized hook

if [[ "${1:-}" == "--vim" ]]; then
    command -v vim >/dev/null || die "vim is not installed."
    export PYKIDS_EDITOR=vim; shift
fi
if [[ "${PYKIDS_EDITOR:-micro}" == micro ]] && ! command -v micro >/dev/null; then
    die "Please install micro first:  sudo apt install micro   (or use ./learn --vim)"
fi

case "${1:-}" in
    --in-tmux)  # F2 popup inside the cockpit
        file=$(pick_file)
        [[ -n "$file" ]] && open_window "$file"
        exit 0 ;;
    stop)
        "${T[@]}" kill-server 2>/dev/null || true
        echo "🐍 Bye!"; exit 0 ;;
    new)
        file=$(new_file "${2:-}") ;;
    -h|--help|help)
        sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    "")
        file=$(welcome) ;;
    open)
        file=$(pick_file) ;;
    *)
        [[ -f "$1" ]] || die "Can't find the file: $1"
        file=$(python3 -c 'import os, sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))' "$1" "$ROOT") ;;
esac

[[ -n "${file:-}" ]] || exit 0
open_window "$file"

# Attach (unless we are already looking at the cockpit).
if [[ "${TMUX:-}" != *"/pykids,"* ]]; then
    TMUX= exec "${T[@]}" attach -t "$SESSION"
fi
